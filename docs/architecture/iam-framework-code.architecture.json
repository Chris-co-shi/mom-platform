  "cards": [
    {
      "dot": "cyan",
      "title": "IAM 分层结论",
      "items": [
        "api/client/server 三模块分离；Server 内保持 Web → Application → Domain",
        "Infrastructure 实现 Domain/Application Port，Configuration 仅负责装配",
        "认证、管理、恢复和权限引用共享同一身份与授权事实"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与状态",
      "items": [
        "Spring Authorization Server 与 Resource Server 在 IAM Servlet Runtime 内协作",
        "PostgreSQL 是身份、RBAC、Session、Refresh 链与安全审计的权威存储",
        "Redis 保存带 TTL 的 revoked SID；不可用时按安全语义 fail-closed"
      ]
    },
    {
      "dot": "violet",
      "title": "Framework 使用边界",
      "items": [
        "IAM 直接使用 webmvc、security、data、tracing、metrics；Client 另用 openfeign",
        "cache、idempotency、messaging、outbox、rate-limit、resilience 当前不是 IAM 直接依赖",
        "data-permission、logging、observation、seata、test 当前主要是 POM/依赖边界或测试支撑"
      ]
    }
  ]
}
